<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <DemoRevision Condition="'$(DemoRevision)'==''">1</DemoRevision>
    <Version>$(DemoRevision).0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <AssemblyName>Auralis.Sample.Pages</AssemblyName>
    <DefineConstants Condition="'$(DemoRevision)'=='2'">$(DefineConstants);EXPANDED_PAGES</DefineConstants>
    <NuGetAudit>false</NuGetAudit>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../../Auralis.Platform.Abstractions/Auralis.Platform.Abstractions.csproj" />
    <None Include="manifest-v$(DemoRevision).json" CopyToOutputDirectory="Always" TargetPath="platform.plugin.json" />
  </ItemGroup>
</Project>
