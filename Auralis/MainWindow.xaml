<Window x:Class="Auralis.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Auralis"
        Icon="Assets/Auralis.ico"
        Width="1280"
        Height="820"
        MinWidth="720"
        MinHeight="480"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="#F4F4F4">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      ResizeBorderThickness="8"
                      CornerRadius="0"
                      GlassFrameThickness="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <Grid x:Name="Root" Background="#F4F4F4">
        <Border x:Name="MaterialCaptionBacking" Height="48" VerticalAlignment="Top" IsHitTestVisible="False" Visibility="Collapsed" />
        <!-- WebView2 owns a child HWND. Keep a native WPF resize frame around it in restored
             windows so every edge and corner receives Windows non-client resize input. -->
        <wv2:WebView2 x:Name="PlayerWebView" Margin="8" />
        <Grid x:Name="NativeSplash"
              Panel.ZIndex="20"
              Background="#F4F4F4"
              IsHitTestVisible="False">
            <Grid.Triggers>
                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="SplashContent"
                                             Storyboard.TargetProperty="Opacity"
                                             From="0" To="1" Duration="0:0:0.34" />
                            <DoubleAnimation Storyboard.TargetName="SplashMark"
                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                             From="0.86" To="1" Duration="0:0:0.48">
                                <DoubleAnimation.EasingFunction>
                                    <BackEase Amplitude="0.22" EasingMode="EaseOut" />
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="SplashMark"
                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                             From="0.86" To="1" Duration="0:0:0.48">
                                <DoubleAnimation.EasingFunction>
                                    <BackEase Amplitude="0.22" EasingMode="EaseOut" />
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Grid.Triggers>
            <StackPanel x:Name="SplashContent"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Opacity="0">
                <Border x:Name="SplashMark"
                        Width="62"
                        Height="62"
                        HorizontalAlignment="Center"
                        CornerRadius="15"
                        Background="#6B9DCA"
                        RenderTransformOrigin="0.5,0.5">
                    <Border.RenderTransform>
                        <ScaleTransform ScaleX="0.86" ScaleY="0.86" />
                    </Border.RenderTransform>
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                        <Rectangle Width="3" Height="15" Margin="2,0" RadiusX="2" RadiusY="2" Fill="White" />
                        <Rectangle Width="3" Height="25" Margin="2,0" RadiusX="2" RadiusY="2" Fill="White" />
                        <Rectangle Width="3" Height="32" Margin="2,0" RadiusX="2" RadiusY="2" Fill="White" />
                        <Rectangle Width="3" Height="23" Margin="2,0" RadiusX="2" RadiusY="2" Fill="White" />
                        <Rectangle Width="3" Height="14" Margin="2,0" RadiusX="2" RadiusY="2" Fill="White" />
                    </StackPanel>
                </Border>
                <TextBlock Margin="0,17,0,0"
                           HorizontalAlignment="Center"
                           FontFamily="Segoe UI Variable Display, Segoe UI"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Foreground="#202020"
                           Text="auralis" />
                <TextBlock x:Name="NativeSplashSubtitle"
                           Margin="0,5,0,0"
                           HorizontalAlignment="Center"
                           FontFamily="Segoe UI Variable Text, Segoe UI"
                           FontSize="11"
                           Foreground="#707070"
                           Text="你的本地音乐" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
