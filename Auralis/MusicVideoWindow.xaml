<Window x:Class="Auralis.MusicVideoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Auralis · MV"
        Icon="Assets/Auralis.ico"
        Width="1040"
        Height="650"
        MinWidth="720"
        MinHeight="480"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="#0B0B0B"
        PreviewKeyDown="Window_PreviewKeyDown">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      ResizeBorderThickness="6"
                      CornerRadius="0"
                      GlassFrameThickness="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <SolidColorBrush x:Key="VideoTextBrush" Color="#F6F6F6" />
        <SolidColorBrush x:Key="VideoMutedTextBrush" Color="#B9B9B9" />
        <SolidColorBrush x:Key="VideoButtonHoverBrush" Color="#2FFFFFFF" />
        <Style x:Key="ChromeButton" TargetType="Button">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="40" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource VideoTextBrush}" />
            <Setter Property="FontFamily" Value="Segoe Fluent Icons" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource VideoButtonHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.72" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TransportButton" TargetType="Button" BasedOn="{StaticResource ChromeButton}">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="FontSize" Value="17" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                CornerRadius="8"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource VideoButtonHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.7" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="VideoSlider" TargetType="Slider">
            <Setter Property="Height" Value="22" />
            <Setter Property="Foreground" Value="#6B9DCA" />
            <Setter Property="Background" Value="#55FFFFFF" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Height="22" VerticalAlignment="Center">
                            <Track x:Name="PART_Track" VerticalAlignment="Center">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" IsTabStop="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="4" CornerRadius="2" Background="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Slider}}" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" IsTabStop="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="4" CornerRadius="2" Background="{Binding Background, RelativeSource={RelativeSource AncestorType=Slider}}" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="14" Height="14">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border CornerRadius="7" Background="#F7F7F7" BorderBrush="#38000000" BorderThickness="1" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="Root" Background="#0B0B0B" Opacity="0">
        <Grid.RowDefinitions>
            <RowDefinition x:Name="TopRow" Height="52" />
            <RowDefinition Height="*" />
            <RowDefinition Height="90" />
        </Grid.RowDefinitions>

        <Border Grid.Row="1" Background="#000000" MouseLeftButtonDown="VideoSurface_MouseLeftButtonDown">
            <Image x:Name="VideoHost" Stretch="Uniform" />
        </Border>

        <Border x:Name="TopChrome"
                Grid.Row="0"
                Background="#D9181818"
                MouseLeftButtonDown="TopChrome_MouseLeftButtonDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="18,0,12,0" VerticalAlignment="Center">
                    <TextBlock x:Name="TitleText"
                               Foreground="{StaticResource VideoTextBrush}"
                               FontFamily="Segoe UI Variable Display, Segoe UI"
                               FontSize="14"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="ArtistText"
                               Margin="0,2,0,0"
                               Foreground="{StaticResource VideoMutedTextBrush}"
                               FontFamily="Segoe UI Variable Text, Segoe UI"
                               FontSize="12"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Style="{StaticResource ChromeButton}" Content="&#xE921;" ToolTip="最小化" Click="Minimize_Click" />
                    <Button x:Name="MaximizeButton" Style="{StaticResource ChromeButton}" Content="&#xE922;" ToolTip="最大化" Click="Maximize_Click" />
                    <Button Style="{StaticResource ChromeButton}" Content="&#xE8BB;" ToolTip="关闭" Click="Close_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="ButtonBorder" Property="Background" Value="#C42B1C" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2"
                Background="#E0181818">
            <Grid Margin="18,10,18,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="PositionText"
                               Width="46"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource VideoMutedTextBrush}"
                               FontFamily="Segoe UI Variable Text, Segoe UI"
                               FontSize="12"
                               Text="0:00" />
                    <Slider x:Name="ProgressSlider"
                            Grid.Column="1"
                            Style="{StaticResource VideoSlider}"
                            Margin="10,0"
                            Minimum="0"
                            Maximum="1"
                            Value="0"
                            IsMoveToPointEnabled="True"
                            PreviewMouseDown="ProgressSlider_PreviewMouseDown"
                            PreviewMouseUp="ProgressSlider_PreviewMouseUp" />
                    <TextBlock x:Name="DurationText"
                               Grid.Column="2"
                               Width="46"
                               TextAlignment="Right"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource VideoMutedTextBrush}"
                               FontFamily="Segoe UI Variable Text, Segoe UI"
                               FontSize="12"
                               Text="0:00" />
                </Grid>
                <Grid Grid.Row="1" Margin="0,7,0,0">
                    <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                        <Button x:Name="PlayPauseButton"
                                Width="46"
                                Height="46"
                                Margin="0,-3,0,0"
                                BorderThickness="0"
                                Background="#6B9DCA"
                                Foreground="White"
                                FontFamily="Segoe Fluent Icons"
                                FontSize="18"
                                Content="&#xE768;"
                                ToolTip="播放"
                                Cursor="Hand"
                                Click="PlayPause_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="ButtonBorder" CornerRadius="23" Background="{TemplateBinding Background}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="ButtonBorder" Property="Background" Value="#78A9D4" />
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="ButtonBorder" Property="RenderTransformOrigin" Value="0.5,0.5" />
                                            <Setter TargetName="ButtonBorder" Property="RenderTransform">
                                                <Setter.Value><ScaleTransform ScaleX="0.94" ScaleY="0.94" /></Setter.Value>
                                            </Setter>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                        <Button x:Name="MuteButton" Style="{StaticResource TransportButton}" Content="&#xE767;" ToolTip="静音" Click="Mute_Click" />
                        <Slider x:Name="VolumeSlider"
                                Style="{StaticResource VideoSlider}"
                                Width="92"
                                Margin="5,0,12,0"
                                Minimum="0"
                                Maximum="100"
                                Value="80"
                                VerticalAlignment="Center"
                                ValueChanged="VolumeSlider_ValueChanged" />
                        <Button Style="{StaticResource TransportButton}" Content="&#xE740;" ToolTip="全屏 (F11)" Click="Fullscreen_Click" />
                    </StackPanel>
                    <Border HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Padding="8,4"
                            CornerRadius="6"
                            Background="#24FFFFFF">
                        <TextBlock x:Name="FormatText"
                                   Foreground="{StaticResource VideoMutedTextBrush}"
                                   FontFamily="Segoe UI Variable Text, Segoe UI"
                                   FontSize="12"
                                   Text="MV" />
                    </Border>
                </Grid>
            </Grid>
        </Border>

        <Border x:Name="StatusOverlay" Grid.Row="1" Background="#F0000000">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressBar x:Name="LoadingProgress"
                             Width="150"
                             Height="3"
                             IsIndeterminate="True"
                             Foreground="#6B9DCA" />
                <TextBlock x:Name="StatusText"
                           Margin="0,16,0,0"
                           MaxWidth="480"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Foreground="{StaticResource VideoTextBrush}"
                           FontFamily="Segoe UI Variable Text, Segoe UI"
                           FontSize="14"
                           Text="正在准备 MV…" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
