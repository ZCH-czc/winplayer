<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <NuGetAudit>false</NuGetAudit>
    <ApplicationManifest>../../Auralis/app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4129.50" />
    <ProjectReference Include="../../Auralis.MediaTransport.Host/Auralis.MediaTransport.Host.csproj" />
    <ProjectReference Include="../../Auralis.MediaTransport.Http/Auralis.MediaTransport.Http.csproj" />
    <!-- Compile the actual production handler and composition, not a copied test implementation. -->
    <Compile Include="../../Auralis/MainWindow.MediaTransportComponents.cs" Link="MainWindow.MediaTransportComponents.cs" />
    <Compile Include="../../Auralis/Services/MediaTransportServices.cs" Link="MediaTransportServices.cs" />
    <Content Include="../../Auralis/wwwroot/**/*" Link="wwwroot/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
